    "@defi-workflow-engine/reference-reconciler": "workspace:0.1.0",
    "@defi-workflow-engine/workflow-contracts": "workspace:0.3.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@sinclair/typebox": "0.34.52",
